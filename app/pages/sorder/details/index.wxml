<!-- 状态栏区域 -->
<view class="cu-custom" style="height:{{CustomBar}}px;">
    <view class="cu-bar fixed none-bg text-white bg-img" style="height:{{CustomBar}}px;padding-top:{{StatusBar}}px;">
        <navigator class='action canui-head-title' open-type="navigateBack" hover-class="none">
            <text class='icon-back'></text>
            预约详情
        </navigator>
    </view>
</view>

<view class="detail-page" style="padding-top: {{CustomBar}}px;">
    <view wx:if="{{loading}}" class="detail-empty">正在加载详情...</view>
    <view wx:elif="{{errorMsg}}" class="detail-empty">{{errorMsg}}</view>

    <block wx:else>
        <view class="status-banner {{statusClass}}">
            <view class="status-name">{{statusName}}</view>
            <view class="status-no">预约单号 {{reservation.reservationNo}}</view>
        </view>

        <view wx:if="{{canVerify}}" class="detail-card qr-card">
            <view class="card-title">核销二维码</view>
            <view wx:if="{{qrUrl && !qrError}}" class="qr-box">
                <image class="qr-image" src="{{qrUrl}}" mode="aspectFit" show-menu-by-longpress bindtap="previewQr" binderror="onQrError"></image>
            </view>
            <view wx:else class="qr-tip">{{qrError ? '二维码加载失败，请联系景区' : '二维码暂不可用'}}</view>
            <view class="qr-no">{{reservation.reservationNo}}</view>
            <view class="qr-tip">出示给工作人员核销，点击可预览、长按可保存</view>
        </view>
        <view wx:else class="detail-card qr-card">
            <view class="card-title">核销二维码</view>
            <view class="qr-tip">当前订单「{{statusName}}」，二维码不可用于核销</view>
        </view>

        <view class="detail-card">
            <view class="card-title">景区信息</view>
            <view class="spot-row">
                <image wx:if="{{spotCover}}" class="spot-cover" src="{{spotCover}}" mode="aspectFill"></image>
                <view wx:else class="spot-cover spot-cover-empty">景区</view>
                <view class="spot-info">
                    <view class="spot-name">{{spot.name || '景区'}}</view>
                    <view class="spot-line">{{category.name || '景区'}}</view>
                    <view class="spot-line">{{spot.address || '暂无地址'}}</view>
                    <view class="spot-line">开放时间：{{spot.openingHours || '暂无'}}</view>
                </view>
            </view>
            <view wx:if="{{spot.brief}}" class="spot-brief">{{spot.brief}}</view>
        </view>

        <view class="detail-card">
            <view class="card-title">预约信息</view>
            <view class="info-row"><text>游览日期</text><text>{{reservation.visitDate}}</text></view>
            <view class="info-row"><text>预约时段</text><text>{{reservation.visitTimeSlot}}</text></view>
            <view class="info-row"><text>预约人数</text><text>{{reservation.visitorCount}} 人</text></view>
            <view class="info-row"><text>联系人</text><text>{{reservation.contactName}}</text></view>
            <view class="info-row"><text>联系电话</text><text>{{reservation.contactMobile}}</text></view>
            <view class="info-row"><text>已核销人数</text><text>{{reservation.verifiedCount || 0}} 人</text></view>
            <view wx:if="{{reservation.remark}}" class="info-row"><text>备注</text><text>{{reservation.remark}}</text></view>
            <view class="info-row"><text>下单时间</text><text>{{reservation.createdAt}}</text></view>
        </view>

        <view wx:if="{{verifications.length}}" class="detail-card">
            <view class="card-title">核销记录</view>
            <view class="verify-row" wx:for="{{verifications}}" wx:key="id">
                <text>{{item.verifiedAt}}</text>
                <text>核销 {{item.verifiedCount}} 人 · {{item.result === 1 ? '成功' : '失败'}}</text>
            </view>
        </view>

        <view class="detail-card">
            <view class="card-title">预约用户</view>
            <view class="info-row"><text>昵称</text><text>{{user.nickname || '微信用户'}}</text></view>
            <view class="info-row"><text>手机号</text><text>{{user.mobile || '暂无'}}</text></view>
        </view>
    </block>
</view>
