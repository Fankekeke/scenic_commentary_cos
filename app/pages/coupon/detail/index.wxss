page {
    background: #f4f7fb;
    padding: 0;
}
.cu-custom {
    position: absolute;
    top: 0;
    width: 100%;
    z-index: 10;
}
.cu-custom .cu-bar {
    padding-right: inherit;
    background-image: linear-gradient(45deg, #0081ff, #1cbbb4);
}
.bulletin-detail {
    min-height: 100vh;
    box-sizing: border-box;
    padding-left: 24rpx;
    padding-right: 24rpx;
    padding-bottom: 60rpx;
}
.detail-card {
    margin-top: 24rpx;
    background: #fff;
    border-radius: 20rpx;
    padding: 36rpx 30rpx;
    box-shadow: 0 6rpx 24rpx rgba(31, 45, 61, 0.06);
}
.detail-tag {
    display: inline-block;
    font-size: 20rpx;
    color: #0081ff;
    background: rgba(0, 129, 255, 0.1);
    padding: 6rpx 18rpx;
    border-radius: 100rpx;
}
.detail-title {
    margin-top: 20rpx;
    font-size: 38rpx;
    font-weight: 600;
    color: #1f2d3d;
    line-height: 1.5;
}
.detail-meta {
    display: flex;
    justify-content: space-between;
    margin-top: 20rpx;
    padding-bottom: 24rpx;
    border-bottom: 1rpx solid #eef1f5;
    font-size: 22rpx;
    color: #9aa7b5;
}
.detail-content {
    margin-top: 28rpx;
    font-size: 28rpx;
    color: #414d5e;
    line-height: 1.9;
    text-align: justify;
}
.detail-images {
    margin-top: 30rpx;
}
.detail-image {
    display: block;
    width: 100%;
    height: 360rpx;
    border-radius: 12rpx;
    margin-bottom: 20rpx;
    background: #eef2f7;
}
.bulletin-empty {
    text-align: center;
    color: #9aa7b5;
    font-size: 26rpx;
    padding: 120rpx 0;
}
